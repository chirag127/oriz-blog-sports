---
/**
 * /  — SCOREBOARD / BROADCAST rundown (archetype-specific, not the sibling
 * newspaper-strata front page).
 *
 * Structure:
 *   1. MATCH OF THE DAY — a broadcast hero panel for the lead post: giant
 *      condensed headline, a "VS" scoreline lockup (desk vs matchday), and a
 *      stats strip (date · reading time · desk).
 *   2. THE RUNDOWN — recent posts as MATCH CARDS in a broadcast grid. Each
 *      card carries a header strip (desk badge + date) and a footer stats
 *      strip (reading time · desk colour bar) — fixture-panel styling.
 *   3. SEASON STANDINGS — in-progress series as a broadcast standings table
 *      (played / of / last).
 *   4. THE DESKS — category chips as a broadcast desk selector.
 *
 * Bold condensed type (Anton), broadcast graphics, no magazine card grid.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const rundown = allPosts.slice(1, 10)

const seriesAll = await getSeriesWithCounts()
type Standing = { name: string; slug: string; played: number; total: number; latest: Date }
const standings: Standing[] = []
for (const { series, count } of seriesAll.slice(0, 5)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce((mx, p) => (p.data.pubDate > mx ? p.data.pubDate : mx), parts[0].data.pubDate)
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  standings.push({ name: series, slug: slugifyTag(series), played: count, total, latest })
}
standings.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const now = new Date()
const season = now.getFullYear() - 2018
const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function iso(d: Date) { return d.toISOString().slice(0, 10) }
function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'TODAY'
  if (days === 1) return '1D'
  if (days < 30) return `${days}D`
  const months = Math.floor(days / 30)
  if (months < 12) return `${months}MO`
  return `${Math.floor(days / 365)}Y`
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="The Chalkboard — matchday feed"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="broadcast">
    {/* ── 1 · MATCH OF THE DAY ─────────────────────────────────────────── */}
    {lead && (
      <section class="motd" data-vertical={leadVertical} aria-labelledby="motd-title">
        <div class="motd-strip mono">
          <span class="motd-badge">MATCH OF THE DAY</span>
          <span class="motd-season">SEASON {season}</span>
          <span class="motd-count">{allPosts.length} FILED</span>
        </div>
        <a class="motd-link" href={`/blog/${lead.id}`}>
          <div class="motd-scoreline mono" aria-hidden="true">
            <span class="motd-side motd-desk">{verticalLabel(leadVertical)}</span>
            <span class="motd-vs">VS</span>
            <span class="motd-side motd-date">{iso(lead.data.pubDate)}</span>
          </div>
          <h1 id="motd-title" class="motd-title">{lead.data.title}</h1>
          <p class="motd-dek">{lead.data.description}</p>
          <div class="statstrip mono">
            <span class="stat"><span class="stat-k">KICKOFF</span><span class="stat-v">{iso(lead.data.pubDate)}</span></span>
            <span class="stat"><span class="stat-k">RUNTIME</span><span class="stat-v">{leadRt}</span></span>
            <span class="stat"><span class="stat-k">DESK</span><span class="stat-v">{verticalLabel(leadVertical)}</span></span>
            <span class="stat stat-cta"><span class="stat-v">WATCH THE TAPE →</span></span>
          </div>
        </a>
      </section>
    )}

    {/* ── 2 · THE RUNDOWN — match cards ────────────────────────────────── */}
    <section class="section" aria-labelledby="rundown-h">
      <div class="section-head">
        <h2 id="rundown-h" class="section-h">The rundown</h2>
        <a class="section-more mono" href="/archive/">FULL SCHEDULE ({allPosts.length}) →</a>
      </div>
      <ul class="fixtures">
        {rundown.map((p, i) => {
          const v = postVertical(p)
          return (
            <li class="fixture" data-vertical={v} style={`--i:${i}`}>
              <a class="fixture-link" href={`/blog/${p.id}`}>
                <div class="fixture-top mono">
                  <span class="fixture-desk">{verticalLabel(v)}</span>
                  <span class="fixture-date">{iso(p.data.pubDate)}</span>
                </div>
                <h3 class="fixture-title">{p.data.title}</h3>
                <p class="fixture-dek">{p.data.description}</p>
                <div class="fixture-stats mono">
                  <span class="fixture-rt">{p.data.readingTime ?? readingTimeFor(p)}</span>
                  <span class="fixture-ago">{ago(p.data.pubDate)}</span>
                </div>
              </a>
            </li>
          )
        })}
      </ul>
    </section>

    {/* ── 3 · SEASON STANDINGS ─────────────────────────────────────────── */}
    {standings.length > 0 && (
      <section class="section" aria-labelledby="standings-h">
        <div class="section-head">
          <h2 id="standings-h" class="section-h">Season standings</h2>
          <a class="section-more mono" href="/series/">ALL SEASONS →</a>
        </div>
        <div class="standings" role="table" aria-label="Series standings">
          <div class="standings-head mono" role="row">
            <span role="columnheader">Series</span>
            <span role="columnheader" class="col-num">Played</span>
            <span role="columnheader" class="col-num">Of</span>
            <span role="columnheader" class="col-num">Last</span>
          </div>
          {standings.map((s, i) => (
            <a class="standings-row" href={`/series/${s.slug}/`} role="row" style={`--i:${i}`}>
              <span class="std-rank mono" role="cell">{String(i + 1).padStart(2, '0')}</span>
              <span class="std-name" role="cell">{s.name}</span>
              <span class="std-played mono" role="cell">{s.played}</span>
              <span class="std-total mono" role="cell">{s.total}</span>
              <span class="std-last mono" role="cell">{ago(s.latest)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* ── 4 · THE DESKS ────────────────────────────────────────────────── */}
    {cats.length > 0 && (
      <section class="section" aria-labelledby="desks-h">
        <div class="section-head">
          <h2 id="desks-h" class="section-h">The desks</h2>
        </div>
        <div class="desks">
          {cats.map((c) => (
            <a class="desk" href={`/categories/${slugifyTag(c.category)}/`} data-vertical={verticalFor(c.category)}>
              <span class="desk-name">{c.category}</span>
              <span class="desk-count mono">{c.count}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .broadcast {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding: clamp(1.25rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2rem) 3rem;
  }

  /* desk-colour var routing (shared by motd + fixtures + desks) */
  [data-vertical='dev'] { --v: var(--v-dev); }
  [data-vertical='finance'] { --v: var(--v-finance); }
  [data-vertical='culture'] { --v: var(--v-culture); }
  [data-vertical='health'] { --v: var(--v-health); }
  [data-vertical='personal'] { --v: var(--v-personal); }

  /* ── 1 · MATCH OF THE DAY ─────────────────────────────────────────── */
  .motd {
    --v: var(--v-personal);
    border: 1px solid var(--rule-strong);
    border-top: 4px solid var(--accent);
    border-radius: var(--radius-card);
    background:
      radial-gradient(130% 120% at 85% 0%, color-mix(in oklab, var(--accent) 10%, transparent), transparent 60%),
      var(--pitch-2);
    overflow: hidden;
  }
  .motd-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem clamp(1rem, 3vw, 1.75rem);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in oklab, var(--pitch) 55%, transparent);
  }
  .motd-badge {
    color: var(--color-accent-fg);
    background: var(--accent);
    padding: 0.2rem 0.5rem;
    font-weight: 700;
    border-radius: 2px;
  }
  .motd-count { margin-left: auto; }
  .motd-link {
    display: block;
    padding: clamp(1.25rem, 4vw, 2.25rem) clamp(1rem, 3vw, 1.75rem) clamp(1rem, 3vw, 1.5rem);
    color: var(--ink);
    text-decoration: none;
  }
  .motd-scoreline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 12px;
    letter-spacing: 0.14em;
    margin-bottom: 0.9rem;
  }
  .motd-desk { color: var(--v); font-weight: 700; }
  .motd-vs {
    color: var(--color-accent-fg);
    background: var(--accent);
    padding: 0.1rem 0.4rem;
    font-weight: 700;
    border-radius: 2px;
  }
  .motd-date { color: var(--ink-mute); }
  .motd-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 8vw, 5rem);
    line-height: 0.9;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
    max-width: 18ch;
  }
  .motd-link:hover .motd-title { color: var(--accent); }
  .motd-dek {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink-mute);
    margin: 1rem 0 0;
    max-width: 62ch;
  }
  .statstrip {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.9rem;
    border-right: 1px solid var(--rule);
    flex: 1 1 auto;
  }
  .stat:last-child { border-right: 0; }
  .stat-k { font-size: 9.5px; letter-spacing: 0.16em; color: var(--ink-mute); }
  .stat-v { font-size: 13px; font-weight: 700; color: var(--ink); }
  .stat-cta { flex: 0 0 auto; justify-content: center; background: color-mix(in oklab, var(--accent) 12%, transparent); }
  .stat-cta .stat-v { color: var(--accent); }
  .motd-link:hover .stat-cta { background: var(--accent); }
  .motd-link:hover .stat-cta .stat-v { color: var(--color-accent-fg); }

  /* ── section chrome ───────────────────────────────────────────────── */
  .section { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--rule-strong);
  }
  .section-h {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
    color: var(--ink);
  }
  .section-more {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
    text-decoration: none;
    white-space: nowrap;
  }
  .section-more:hover { color: var(--accent); }

  /* ── 2 · fixtures / match cards ───────────────────────────────────── */
  .fixtures {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .fixture {
    --v: var(--v-personal);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--v);
    border-radius: var(--radius-card);
    background: var(--pitch-2);
    overflow: hidden;
    transition: transform var(--dur-fast, 120ms) var(--ease-out), border-color var(--dur-fast, 120ms) ease;
  }
  .fixture:hover { transform: translateY(-3px); border-color: var(--rule-strong); }
  .fixture:hover { border-left-color: var(--accent); }
  .fixture-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem 1.1rem 0;
    color: var(--ink);
    text-decoration: none;
  }
  .fixture-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 10px;
    letter-spacing: 0.14em;
    margin-bottom: 0.75rem;
  }
  .fixture-desk { color: var(--v); font-weight: 700; }
  .fixture-date { color: var(--ink-mute); }
  .fixture-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 0.98;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
    color: var(--ink);
  }
  .fixture-link:hover .fixture-title { color: var(--accent); }
  .fixture-dek {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-mute);
    margin: 0.6rem 0 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .fixture-stats {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 0.6rem 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--rule);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }
  .fixture-rt { color: var(--ink); font-weight: 700; }
  .fixture-ago {
    color: var(--v);
    border: 1px solid color-mix(in oklab, var(--v) 40%, transparent);
    border-radius: 2px;
    padding: 0.1rem 0.35rem;
    font-weight: 700;
  }

  /* ── 3 · standings ────────────────────────────────────────────────── */
  .standings {
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .standings-head {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 4rem 4rem;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    background: color-mix(in oklab, var(--pitch) 60%, transparent);
    border-bottom: 1px solid var(--rule);
  }
  .standings-head span:first-child { grid-column: 1 / 3; }
  .col-num { text-align: right; }
  .standings-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 4rem 4rem 4rem;
    gap: 0.5rem;
    align-items: center;
    padding: 0.75rem 1rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .standings-row:last-child { border-bottom: 0; }
  .standings-row:hover { background: color-mix(in oklab, var(--accent) 8%, transparent); }
  .std-rank { color: var(--accent); font-weight: 700; font-size: 13px; }
  .std-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .standings-row:hover .std-name { color: var(--accent); }
  .std-played, .std-total, .std-last { text-align: right; font-size: 13px; color: var(--ink); }
  .std-total { color: var(--ink-mute); }
  .std-last { color: var(--ink-mute); }

  @media (max-width: 560px) {
    .standings-head { grid-template-columns: minmax(0, 1fr) 3rem 3rem; }
    .standings-head span:first-child { grid-column: 1; }
    .standings-row { grid-template-columns: 2rem minmax(0, 1fr) 3rem 3rem; }
    .std-total { display: none; }
    .standings-head span:nth-child(3) { display: none; }
  }

  /* ── 4 · desks ────────────────────────────────────────────────────── */
  .desks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .desk {
    --v: var(--v-personal);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--pitch-2);
    color: var(--ink);
    text-decoration: none;
  }
  .desk:hover { border-color: var(--v); background: color-mix(in oklab, var(--v) 12%, var(--pitch-2)); }
  .desk-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .desk-count {
    font-size: 11px;
    font-weight: 700;
    color: var(--v);
    background: color-mix(in oklab, var(--v) 15%, transparent);
    padding: 0.05rem 0.35rem;
    border-radius: 2px;
  }

  /* focus */
  .motd-link:focus-visible,
  .fixture-link:focus-visible,
  .standings-row:focus-visible,
  .desk:focus-visible,
  .section-more:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .fixture { transition: none; }
    .fixture:hover { transform: none; }
  }
</style>
