---
/*
 * Footer — BROADCAST sign-off panel (scoreboard archetype).
 *
 * A full-width "end of transmission" board: a giant condensed sign-off line
 * with the amber floodlight signal, a scoreboard-style link matrix (Fixtures /
 * Seasons / Desks / Booth), then the legal wire.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import {
  getCategoriesWithCounts,
  getTagsWithCounts,
  slugifyTag,
} from '~/lib/blog'

const desks = (await getCategoriesWithCounts()).slice(0, 6).map(({ category, count }) => ({
  name: category,
  slug: slugifyTag(category),
  count,
}))
const tags = (await getTagsWithCounts()).slice(0, 8).map(({ tag }) => tag)
---
<footer class="signoff" role="contentinfo">
  <div class="signoff-hero">
    <p class="signoff-tag mono"><span class="signoff-dot" aria-hidden="true"></span>END OF TRANSMISSION</p>
    <p class="signoff-line">The scoreboard tells you <span class="accent">who</span> won. The tape tells you <span class="accent">why</span>.</p>
    <p class="signoff-attr mono">THE CHALKBOARD · MATCHDAY DESK</p>
  </div>

  <div class="signoff-grid">
    <div class="sg-col">
      <h3 class="sg-h mono">Fixtures</h3>
      <ul>
        <li><a href="/blog/">Latest tape</a></li>
        <li><a href="/archive/">Full schedule</a></li>
        <li><a href="/now/">Now</a></li>
      </ul>
    </div>
    <div class="sg-col">
      <h3 class="sg-h mono">Seasons</h3>
      <ul>
        <li><a href="/series/">All seasons</a></li>
        <li><a href="/blog/">Running threads</a></li>
      </ul>
    </div>
    <div class="sg-col">
      <h3 class="sg-h mono">Desks</h3>
      <ul class="sg-desks">
        <li><a href="/categories/">All desks</a></li>
        {desks.map((d) => <li><a href={`/categories/${d.slug}/`}>{d.name} <span class="sg-num mono">{d.count}</span></a></li>)}
      </ul>
    </div>
    <div class="sg-col">
      <h3 class="sg-h mono">Chalk tags</h3>
      <ul class="sg-tags">
        {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
      </ul>
    </div>
  </div>

  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-sports"
    appName="The Chalkboard"
    bio="Scorecards, tactics, and training — the game broken down for fans, by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .signoff {
    margin-top: 5rem;
    background: color-mix(in oklab, var(--pitch-2) 80%, black);
    color: var(--ink);
    border-top: 3px solid var(--accent);
  }
  .signoff-hero {
    max-width: var(--container-page, 1100px);
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 4vw, 2rem) 1.5rem;
  }
  .signoff-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    color: var(--ink-mute);
  }
  .signoff-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
  }
  .signoff-line {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    line-height: 1.0;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
    max-width: 20ch;
  }
  .signoff-line .accent { color: var(--accent); }
  .signoff-attr {
    margin: 1.25rem 0 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--ink-mute);
  }

  .signoff-grid {
    max-width: var(--container-page, 1100px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 1.5rem clamp(1rem, 4vw, 2rem) 2rem;
    border-top: 1px solid var(--rule);
  }
  .sg-h {
    margin: 0 0 0.9rem;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }
  .sg-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .sg-col a {
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .sg-col a:hover { color: var(--accent); }
  .sg-num { color: var(--ink-mute); font-size: 11px; }
  .sg-tags { flex-direction: row; flex-wrap: wrap; gap: 0.4rem 0.75rem; }
  .sg-tags a { font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-mute); }
  .sg-tags a:hover { color: var(--accent); }
  .sg-col a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (min-width: 768px) {
    .signoff-grid { grid-template-columns: repeat(4, 1fr); gap: 32px; }
  }
</style>
